generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   // "admin" | "editor" | "viewer"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GenerationJobLog {
  id          String   @id @default(cuid())
  jobId       String   @unique
  service     String   // "sportzavod" | "contentzavod"
  durationSec Int
  videosCount Int      @default(0)
  costUsd     Float    @default(0) // реальная стоимость из сервиса-генератора
  status      String   // "done" | "error" | "stopped"
  createdAt   DateTime @default(now())

  @@index([service, createdAt])
  @@index([status, createdAt])
}
