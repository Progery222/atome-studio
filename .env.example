# === Atome Studio — Environment Variables ===
# Copy to .env and fill in values before running docker compose

# Authentication
JWT_SECRET=change-me-in-production
API_KEY=change-me
ADMIN_EMAIL=admin@atome.studio
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin
ADMIN_ALLOWED_IPS=

# Cloudflare
CF_API_TOKEN=
CF_ACCOUNT_ID=

# PostHog
PH_API_KEY=
PH_PROJECT_ID=

# Postman
POSTMAN_API_KEY=

# MinIO (S3-compatible storage)
# Default: uses minio service from docker-compose
MINIO_URL=http://minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET=atome-videos
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1

# External services (set if running outside docker-compose)
SPORTZAVOD_URL=http://sportzavod:8000
CONTENTZAVOD_URL=http://contentzavod:8002
AGENTMUSIC_URL=http://localhost:8080
ATOME_FARM_URL=http://10.8.0.1:8001
AUTONOMY_URL=http://10.8.0.1:8001
ORCHESTRATOR_URL=http://localhost:8001
NODE_AGENT_SECRET=change-me
VLLM_URL=http://91.84.98.58:8000
VLLM_MODEL=Qwen3-VL-32B-AWQ

# StreamCut (Video-to-Shorts AI)
# Runs separately via apps/StreamCut/docker-compose.yml
STREAMCUT_URL=http://localhost:8003
STREAMCUT_SERVICE_PASSWORD=change-me
